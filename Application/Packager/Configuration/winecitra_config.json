{
  "package_name": "wine-citra",
  "version": "0.3.02",
  "section": "utils",
  "priority": "optional",
  "architecture": "all",
  "depends": "python3, python3-pyqt6, python3-xlib, wine",
  "recommends": "winetricks, gamemode, mangohud, pulseaudio-utils, mesa-vulkan-drivers",
  "maintainer": "Blitzdragon <blitzdragon@localhost>",
  "description": "WINE Citra - Isolated Wine Prefix Runner (Beta)",
  "source_dir": "..",
  "entry_point": "main.py",
  "include": [
    "main.py",
    "Core",
    "UI",
    "SettingsMemory"
  ],
  "exclude": [
    "LICENSE",
    "LICENSE.*",
    "LICENCE",
    "LICENCE.*",
    "README",
    "README.*",
    "Licensing",
    "licensing"
  ],
  "install_dir": "/usr/lib/wine-citra",
  "output_dir": "/home/blitzzdragon",
  "desktop_entry": true
}
